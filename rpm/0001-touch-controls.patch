@@ -0,0 +1,750 @@
+//
+// Touch screen controls (virtual stick, look swipe, buttons, menu mode)
+// and 90 degree output rotation for portrait-only windows.
+//
+// Finger positions are normalized to the window and mapped to the
+// (possibly rotated) drawing space. Input is injected as ordinary key
+// and mouse events, so key rebinding keeps working.
+//
+// In menus a swipe moves the cursor (with repeat) and a tap selects.
+//
+// This program is free software; you can redistribute it and/or
+// modify it under the terms of the GNU General Public License
+// as published by the Free Software Foundation; either version 2
+// of the License, or (at your option) any later version.
+//
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "SDL.h"
+
+#include "d_event.h"
+#include "doomkeys.h"
+#include "doomtype.h"
+#include "i_timer.h"
+#include "i_touch.h"
+#include "m_argv.h"
+#include "m_controls.h"
+
+#define MAX_FINGERS   10
+#define STICK_ZONE    0.40f   // stick starts left of this x
+#define STICK_DEAD    0.06f   // in drawing heights
+#define RUN_AT        0.16f   // stick distance that holds run
+#define TURN_FULL     0.20f   // stick distance for full turn speed
+#define TURN_MAX      90.0f   // mouse counts per tic at full turn
+#define LOOK_GAIN     0.6f    // mouse counts per swiped pixel
+#define TAP_MS        300     // max touch time for a menu tap
+#define REPEAT_FIRST  350     // ms before menu repeat starts
+#define REPEAT_NEXT   120     // ms between menu repeats
+
+// Only Doom and Strife define this. Others stay in game mode.
+extern boolean menuactive __attribute__((weak));
+
+typedef enum
+{
+    ROLE_NONE,
+    ROLE_STICK,
+    ROLE_LOOK,
+    ROLE_BUTTON
+} role_t;
+
+typedef struct
+{
+    SDL_FingerID id;
+    role_t role;
+    int button;
+    float ax, ay;       // stick anchor
+    float x, y;         // current position
+    Uint32 t0;          // touch start time
+    Uint32 next_repeat; // menu repeat deadline
+    int navdir;         // menu direction held, -1 none
+    int pulsed;         // a menu key was sent
+    float turn;         // stick turn axis, -1 to 1
+} finger_t;
+
+typedef struct
+{
+    float cx, cy;   // centre as a fraction of the drawing size
+    float r;        // half size in drawing heights
+    int *key;       // bound key variable
+    char glyph;
+    int down;
+} button_t;
+
+static button_t buttons[] =
+{
+    { 0.90f, 0.72f, 0.14f, &key_fire,          'F', 0 },
+    { 0.74f, 0.84f, 0.10f, &key_use,           'U', 0 },
+    { 0.96f, 0.46f, 0.08f, &key_nextweapon,    '>', 0 },
+    { 0.82f, 0.46f, 0.08f, &key_prevweapon,    '<', 0 },
+    { 0.46f, 0.08f, 0.07f, &key_menu_activate, 'M', 0 },
+    { 0.54f, 0.08f, 0.07f, &key_menu_forward,  'E', 0 },
+    { 0.62f, 0.08f, 0.07f, &key_menu_confirm,  'Y', 0 },
+};
+
+#define NUM_BUTTONS ((int) (sizeof(buttons) / sizeof(buttons[0])))
+
+static int *move_keys[2] = { &key_up, &key_down };
+static int *menu_keys[4] =
+    { &key_menu_up, &key_menu_down, &key_menu_left, &key_menu_right };
+static int move_held[2];
+static int run_held;
+
+static finger_t fingers[MAX_FINGERS];
+static boolean enabled;
+static boolean debug;
+static boolean was_menu;
+static int out_w = 1280, out_h = 720;   // drawing size, after rotation
+static int rot;                         // active rotation: 0, 90 or 270
+static float swipe_pending;
+static float turn_accum;
+static int last_tic = -1;
+
+// 5x7 glyphs, one row per byte, bit 4 is the left column.
+static const struct { char c; unsigned char rows[7]; } font[] =
+{
+    { 'F', { 0x1f, 0x10, 0x10, 0x1e, 0x10, 0x10, 0x10 } },
+    { 'U', { 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0e } },
+    { 'M', { 0x11, 0x1b, 0x15, 0x15, 0x11, 0x11, 0x11 } },
+    { 'E', { 0x1f, 0x10, 0x10, 0x1e, 0x10, 0x10, 0x1f } },
+    { '<', { 0x02, 0x04, 0x08, 0x10, 0x08, 0x04, 0x02 } },
+    { '>', { 0x08, 0x04, 0x02, 0x01, 0x02, 0x04, 0x08 } },
+    { 'Y', { 0x11, 0x11, 0x0a, 0x04, 0x04, 0x04, 0x04 } },
+};
+
+static int MenuOn(void)
+{
+    return &menuactive != NULL && menuactive;
+}
+
+// Requested rotation for a portrait window: -rotate 0, 90 or 270.
+static int RotationArg(void)
+{
+    int p = M_CheckParmWithArgs("-rotate", 1);
+
+    if (p > 0)
+    {
+        return atoi(myargv[p + 1]);
+    }
+
+#ifdef HARBOUR_SAILFISH
+    return 90;
+#else
+    return 0;
+#endif
+}
+
+static void PostKey(int type, int key)
+{
+    event_t ev;
+
+    if (key == 0)
+    {
+        return;
+    }
+
+    if (debug)
+    {
+        printf("touch: key %s %d\n", type == ev_keydown ? "down" : "up", key);
+    }
+
+    memset(&ev, 0, sizeof(ev));
+    ev.type = type;
+    ev.data1 = key;
+
+    if (type == ev_keydown)
+    {
+        ev.data2 = key;
+        ev.data3 = key;
+    }
+
+    D_PostEvent(&ev);
+}
+
+static void PulseKey(int key)
+{
+    PostKey(ev_keydown, key);
+    PostKey(ev_keyup, key);
+}
+
+static void PostTurn(int counts)
+{
+    event_t ev;
+
+    memset(&ev, 0, sizeof(ev));
+    ev.type = ev_mouse;
+    ev.data2 = counts;
+    D_PostEvent(&ev);
+}
+
+static finger_t *FindFinger(SDL_FingerID id)
+{
+    int i;
+
+    for (i = 0; i < MAX_FINGERS; ++i)
+    {
+        if (fingers[i].role != ROLE_NONE && fingers[i].id == id)
+        {
+            return &fingers[i];
+        }
+    }
+
+    return NULL;
+}
+
+static finger_t *NewFinger(SDL_FingerID id)
+{
+    int i;
+
+    for (i = 0; i < MAX_FINGERS; ++i)
+    {
+        if (fingers[i].role == ROLE_NONE)
+        {
+            memset(&fingers[i], 0, sizeof(fingers[i]));
+            fingers[i].id = id;
+            fingers[i].navdir = -1;
+            return &fingers[i];
+        }
+    }
+
+    return NULL;
+}
+
+static float Unit(void)
+{
+    return out_w < out_h ? out_w : out_h;
+}
+
+// Window (normalized) to drawing space (normalized).
+static void ToDrawing(float xw, float yw, float *u, float *v)
+{
+    if (rot == 90)
+    {
+        *u = yw;
+        *v = 1.0f - xw;
+    }
+    else if (rot == 270)
+    {
+        *u = 1.0f - yw;
+        *v = xw;
+    }
+    else
+    {
+        *u = xw;
+        *v = yw;
+    }
+}
+
+// Drawing rectangle to window rectangle.
+static SDL_Rect ToWindow(int x, int y, int w, int h)
+{
+    int ow = rot ? out_h : out_w;
+    int oh = rot ? out_w : out_h;
+    SDL_Rect r;
+
+    if (rot == 90)
+    {
+        r.x = ow - (y + h);
+        r.y = x;
+        r.w = h;
+        r.h = w;
+    }
+    else if (rot == 270)
+    {
+        r.x = y;
+        r.y = oh - (x + w);
+        r.w = h;
+        r.h = w;
+    }
+    else
+    {
+        r.x = x;
+        r.y = y;
+        r.w = w;
+        r.h = h;
+    }
+
+    return r;
+}
+
+static int HitButton(float x, float y)
+{
+    int i;
+
+    for (i = 0; i < NUM_BUTTONS; ++i)
+    {
+        float dx = (x - buttons[i].cx) * out_w;
+        float dy = (y - buttons[i].cy) * out_h;
+        float half = buttons[i].r * Unit();
+
+        if (dx > -half && dx < half && dy > -half && dy < half)
+        {
+            return i;
+        }
+    }
+
+    return -1;
+}
+
+// Stick offset from its anchor, in units of the short drawing side.
+static void StickDelta(finger_t *f, float *dx, float *dy)
+{
+    *dx = (f->x - f->ax) * out_w / Unit();
+    *dy = (f->y - f->ay) * out_h / Unit();
+}
+
+static void SetMove(int dir, int on)
+{
+    if (move_held[dir] == on)
+    {
+        return;
+    }
+
+    move_held[dir] = on;
+    PostKey(on ? ev_keydown : ev_keyup, *move_keys[dir]);
+}
+
+static void SetRun(int on)
+{
+    if (run_held == on || key_speed <= 0 || key_speed >= 256)
+    {
+        return;
+    }
+
+    run_held = on;
+    PostKey(on ? ev_keydown : ev_keyup, key_speed);
+}
+
+// Game: up and down are keys, left and right is an analog turn.
+static void UpdateStick(finger_t *f)
+{
+    float dx, dy, a;
+
+    StickDelta(f, &dx, &dy);
+
+    SetMove(0, dy < -STICK_DEAD);
+    SetMove(1, dy > STICK_DEAD);
+    SetRun(fabsf(dy) >= RUN_AT);
+
+    a = fabsf(dx);
+    if (a < STICK_DEAD)
+    {
+        f->turn = 0.0f;
+    }
+    else
+    {
+        a = (a - STICK_DEAD) / (TURN_FULL - STICK_DEAD);
+        f->turn = (dx < 0 ? -1.0f : 1.0f) * (a > 1.0f ? 1.0f : a);
+    }
+}
+
+// Menu cursor: one key per direction change, then repeat while held.
+static void UpdateNav(finger_t *f, Uint32 now)
+{
+    float dx, dy;
+    int dir = -1;
+
+    StickDelta(f, &dx, &dy);
+
+    if (fabsf(dx) >= STICK_DEAD || fabsf(dy) >= STICK_DEAD)
+    {
+        if (fabsf(dy) >= fabsf(dx))
+        {
+            dir = dy < 0 ? 0 : 1;
+        }
+        else
+        {
+            dir = dx < 0 ? 2 : 3;
+        }
+    }
+
+    if (dir != f->navdir)
+    {
+        f->navdir = dir;
+
+        if (dir >= 0)
+        {
+            PulseKey(*menu_keys[dir]);
+            f->pulsed = 1;
+            f->next_repeat = now + REPEAT_FIRST;
+        }
+    }
+    else if (dir >= 0 && now >= f->next_repeat)
+    {
+        PulseKey(*menu_keys[dir]);
+        f->next_repeat = now + REPEAT_NEXT;
+    }
+}
+
+static void ReleaseFinger(finger_t *f)
+{
+    if (f->role == ROLE_STICK)
+    {
+        SetMove(0, 0);
+        SetMove(1, 0);
+        SetRun(0);
+        f->turn = 0.0f;
+    }
+    else if (f->role == ROLE_BUTTON)
+    {
+        buttons[f->button].down = 0;
+        PostKey(ev_keyup, *buttons[f->button].key);
+    }
+
+    f->role = ROLE_NONE;
+}
+
+void I_TouchReleaseAll(void)
+{
+    int i;
+
+    for (i = 0; i < MAX_FINGERS; ++i)
+    {
+        if (fingers[i].role != ROLE_NONE)
+        {
+            ReleaseFinger(&fingers[i]);
+        }
+    }
+}
+
+// Call before the window is created.
+void I_TouchSetHint(void)
+{
+#ifdef SDL_HINT_QTWAYLAND_CONTENT_ORIENTATION
+    int angle = RotationArg();
+
+    // Tells the compositor how the content is drawn. It does not rotate.
+    if (angle == 90)
+    {
+        SDL_SetHint(SDL_HINT_QTWAYLAND_CONTENT_ORIENTATION, "landscape");
+    }
+    else if (angle == 270)
+    {
+        SDL_SetHint(SDL_HINT_QTWAYLAND_CONTENT_ORIENTATION,
+                    "inverted-landscape");
+    }
+#endif
+}
+
+void I_TouchInit(void)
+{
+    if (M_CheckParm("-notouch") > 0)
+    {
+        return;
+    }
+
+    debug = M_CheckParm("-touchdebug") > 0;
+    enabled = SDL_GetNumTouchDevices() > 0 || M_CheckParm("-touch") > 0;
+
+    if (enabled)
+    {
+        // Touches are handled here, do not also synthesize mouse input.
+        SDL_SetHint(SDL_HINT_TOUCH_MOUSE_EVENTS, "0");
+    }
+}
+
+// Called from I_GetEvent. Menu repeat and the once per tic turn input.
+void I_TouchTick(void)
+{
+    Uint32 now;
+    int menu, tic, i, n;
+    float turn;
+
+    if (!enabled)
+    {
+        return;
+    }
+
+    menu = MenuOn();
+
+    if (menu != was_menu)
+    {
+        was_menu = menu;
+        I_TouchReleaseAll();
+        swipe_pending = 0.0f;
+        turn_accum = 0.0f;
+        return;
+    }
+
+    if (menu)
+    {
+        now = SDL_GetTicks();
+
+        for (i = 0; i < MAX_FINGERS; ++i)
+        {
+            if (fingers[i].role == ROLE_STICK)
+            {
+                UpdateNav(&fingers[i], now);
+            }
+        }
+        return;
+    }
+
+    // Mouse events replace each other within a tic, so send one per tic.
+    tic = I_GetTime();
+    if (tic == last_tic)
+    {
+        return;
+    }
+    last_tic = tic;
+
+    turn = 0.0f;
+    for (i = 0; i < MAX_FINGERS; ++i)
+    {
+        if (fingers[i].role == ROLE_STICK)
+        {
+            turn += fingers[i].turn * TURN_MAX;
+        }
+    }
+
+    turn_accum += turn + swipe_pending;
+    swipe_pending = 0.0f;
+    n = (int) turn_accum;
+    turn_accum -= n;
+
+    if (n != 0)
+    {
+        PostTurn(n);
+    }
+}
+
+void I_TouchEvent(SDL_Event *sdlevent)
+{
+    finger_t *f;
+    float x, y, px;
+    Uint32 now = SDL_GetTicks();
+    int b;
+
+    if (!enabled)
+    {
+        return;
+    }
+
+    ToDrawing(sdlevent->tfinger.x, sdlevent->tfinger.y, &x, &y);
+
+    if (debug)
+    {
+        printf("touch: event %d id %d window %.3f %.3f drawing %.3f %.3f"
+               " rot %d menu %d\n",
+               (int) sdlevent->type, (int) sdlevent->tfinger.fingerId,
+               sdlevent->tfinger.x, sdlevent->tfinger.y, x, y, rot,
+               MenuOn());
+    }
+
+    switch (sdlevent->type)
+    {
+        case SDL_FINGERDOWN:
+            f = NewFinger(sdlevent->tfinger.fingerId);
+            if (f == NULL)
+            {
+                break;
+            }
+
+            f->x = x;
+            f->y = y;
+            f->t0 = now;
+            b = HitButton(x, y);
+
+            if (b >= 0)
+            {
+                f->role = ROLE_BUTTON;
+                f->button = b;
+                buttons[b].down = 1;
+                PostKey(ev_keydown, *buttons[b].key);
+            }
+            else if (MenuOn() || x < STICK_ZONE)
+            {
+                f->role = ROLE_STICK;
+                f->ax = x;
+                f->ay = y;
+            }
+            else
+            {
+                f->role = ROLE_LOOK;
+            }
+            break;
+
+        case SDL_FINGERMOTION:
+            f = FindFinger(sdlevent->tfinger.fingerId);
+            if (f == NULL)
+            {
+                break;
+            }
+
+            px = f->x;
+            f->x = x;
+            f->y = y;
+
+            if (f->role == ROLE_STICK)
+            {
+                if (MenuOn())
+                {
+                    UpdateNav(f, now);
+                }
+                else
+                {
+                    UpdateStick(f);
+                }
+            }
+            else if (f->role == ROLE_LOOK)
+            {
+                swipe_pending += (x - px) * out_w * LOOK_GAIN;
+            }
+            break;
+
+        case SDL_FINGERUP:
+            f = FindFinger(sdlevent->tfinger.fingerId);
+            if (f != NULL)
+            {
+                // A short touch without a swipe selects in menus.
+                if (f->role == ROLE_STICK && MenuOn() && !f->pulsed
+                 && now - f->t0 < TAP_MS)
+                {
+                    PulseKey(key_menu_forward);
+                }
+
+                ReleaseFinger(f);
+            }
+            break;
+
+        default:
+            break;
+    }
+}
+
+// Final blit of the game image. Rotates it when the window is portrait.
+void I_TouchCopy(SDL_Renderer *r, SDL_Texture *texture)
+{
+    int ow, oh, lw, lh;
+    SDL_Rect dst;
+    float s;
+
+    SDL_GetRendererOutputSize(r, &ow, &oh);
+    rot = (RotationArg() == 90 || RotationArg() == 270) && ow < oh
+          ? RotationArg() : 0;
+
+    if (rot == 0)
+    {
+        out_w = ow;
+        out_h = oh;
+        SDL_RenderCopy(r, texture, NULL, NULL);
+        return;
+    }
+
+    out_w = oh;
+    out_h = ow;
+
+    // Fit the game aspect into the rotated space, then rotate around
+    // the window centre.
+    SDL_RenderGetLogicalSize(r, &lw, &lh);
+    SDL_RenderSetLogicalSize(r, 0, 0);
+
+    if (lw > 0 && lh > 0)
+    {
+        s = (float) out_w / lw;
+        if ((float) out_h / lh < s)
+        {
+            s = (float) out_h / lh;
+        }
+        dst.w = (int) (lw * s);
+        dst.h = (int) (lh * s);
+    }
+    else
+    {
+        dst.w = out_w;
+        dst.h = out_h;
+    }
+
+    dst.x = ow / 2 - dst.w / 2;
+    dst.y = oh / 2 - dst.h / 2;
+
+    SDL_RenderCopyEx(r, texture, NULL, &dst, rot, NULL, SDL_FLIP_NONE);
+    SDL_RenderSetLogicalSize(r, lw, lh);
+}
+
+static void FillRect(SDL_Renderer *r, int x, int y, int w, int h)
+{
+    SDL_Rect wr = ToWindow(x, y, w, h);
+    SDL_RenderFillRect(r, &wr);
+}
+
+static void OutlineRect(SDL_Renderer *r, int x, int y, int w, int h)
+{
+    SDL_Rect wr = ToWindow(x, y, w, h);
+    SDL_RenderDrawRect(r, &wr);
+}
+
+static void DrawGlyph(SDL_Renderer *r, char c, int cx, int cy, int px)
+{
+    int g, row, col;
+
+    for (g = 0; g < (int) (sizeof(font) / sizeof(font[0])); ++g)
+    {
+        if (font[g].c != c)
+        {
+            continue;
+        }
+
+        for (row = 0; row < 7; ++row)
+        {
+            for (col = 0; col < 5; ++col)
+            {
+                if (font[g].rows[row] & (0x10 >> col))
+                {
+                    FillRect(r, cx + (col - 2) * px - px / 2,
+                             cy + (row - 3) * px - px / 2, px, px);
+                }
+            }
+        }
+        return;
+    }
+}
+
+void I_TouchDraw(SDL_Renderer *r)
+{
+    int lw, lh, i;
+
+    if (!enabled)
+    {
+        return;
+    }
+
+    // Draw in window pixels, outside the logical (aspect corrected) size.
+    SDL_RenderGetLogicalSize(r, &lw, &lh);
+    SDL_RenderSetLogicalSize(r, 0, 0);
+    SDL_SetRenderDrawBlendMode(r, SDL_BLENDMODE_BLEND);
+
+    for (i = 0; i < NUM_BUTTONS; ++i)
+    {
+        int half = (int) (buttons[i].r * Unit());
+        int cx = (int) (buttons[i].cx * out_w);
+        int cy = (int) (buttons[i].cy * out_h);
+
+        SDL_SetRenderDrawColor(r, 255, 255, 255, buttons[i].down ? 110 : 45);
+        FillRect(r, cx - half, cy - half, half * 2, half * 2);
+        SDL_SetRenderDrawColor(r, 255, 255, 255, 160);
+        OutlineRect(r, cx - half, cy - half, half * 2, half * 2);
+        DrawGlyph(r, buttons[i].glyph, cx, cy, half / 5);
+    }
+
+    for (i = 0; i < MAX_FINGERS; ++i)
+    {
+        if (fingers[i].role == ROLE_STICK)
+        {
+            int base = (int) (STICK_DEAD * 2.0f * Unit());
+
+            SDL_SetRenderDrawColor(r, 255, 255, 255, 160);
+            OutlineRect(r, (int) (fingers[i].ax * out_w) - base,
+                        (int) (fingers[i].ay * out_h) - base,
+                        base * 2, base * 2);
+            SDL_SetRenderDrawColor(r, 255, 255, 255, 110);
+            FillRect(r, (int) (fingers[i].x * out_w) - base / 2,
+                     (int) (fingers[i].y * out_h) - base / 2, base, base);
+        }
+    }
+
+    SDL_RenderSetLogicalSize(r, lw, lh);
+}
